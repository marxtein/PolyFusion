# PolyFusion environment template.
# Copy to .env (local dev) or /root/polyfusion.env (Huawei) and fill in.
# NEVER commit a filled-in copy. NEVER put SERVICE_ROLE_KEY here.

# ---- Required by web process ----
SUPABASE_URL=https://tomvvnekqrtqwwgwfsft.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRvbXZ2bmVrcXJ0cXd3Z3dmc2Z0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI3NzU4MDAsImV4cCI6MjA5ODM1MTgwMH0.b-KcBSa1y8LYNvTfBWvGiP_XvDRDkBOD3w_hV8nOyZc

# ---- Server config ----
PORT=8765
REQUIRE_AUTH=1            # set 0 to disable auth gate for local debugging
USE_HTTPS=0               # set 1 to add Secure flag to cookies
POLYFUSION_REQUIRE_EMAIL_CONFIRMATION=1  # set 0 to store new accounts locally without confirmation email
# POLYFUSION_LOCAL_AUTH_DB=~/.polyfusion/auth.sqlite3
# POLYFUSION_HISTORY_DB=~/.polyfusion/history.sqlite3
# POLYFUSION_REPORT_CACHE_DB=~/.polyfusion/report_cache.sqlite3

# ---- In-app SMTP verification (optional) ----
# When POLYFUSION_REQUIRE_EMAIL_CONFIRMATION=1 AND POLYFUSION_SMTP_ENABLED=1,
# signup uses local SQLite auth + sends verification email via this SMTP
# server (bypasses Supabase's ~3 emails/hour free-tier cap). Real password
# lives in .env (gitignored), NEVER in this template.
# POLYFUSION_SMTP_ENABLED=1
# POLYFUSION_SMTP_HOST=smtp.qiye.aliyun.com
# POLYFUSION_SMTP_PORT=465
# POLYFUSION_SMTP_USER=veloalpha@mail.suyuexinghen.cn
# POLYFUSION_SMTP_PASSWORD=...   # set in .env only
# POLYFUSION_SMTP_FROM_NAME=PolyFusion
# PUBLIC_BASE_URL=https://your-public-host.example.cn  # used in verification link

# ---- AI report API ----
CODEX_API_KEY=sk-...
# CODEX_BASE_URL=https://api.codexzh.com/v1
# CODEX_MODEL=gpt-5.4
# OPENAI_ENDPOINT=auto

# ---- Local debug only ----
# Enables POST /api/debug/auth/register on loopback only. Keep disabled in prod.
POLYFUSION_DEBUG_AUTH=0
# For one-off local testing only; export in your shell, do not commit a real key.
# POLYFUSION_DEBUG_SERVICE_ROLE_KEY=...

# ---- Migration script only (do NOT load in web process) ----
# Run scripts/migrate_users_to_supabase.py with this set in the immediate
# shell session; do NOT put it in systemd EnvironmentFile.
# SUPABASE_SERVICE_ROLE_KEY=...
