# ---- Server config ----
PORT=8765
REQUIRE_AUTH=1            # set 0 to disable auth gate for local debugging
USE_HTTPS=0               # set 1 to add Secure flag to cookies

# ---- AI report API ----
CODEX_API_KEY=sk-...
# CODEX_BASE_URL=https://api.codexzh.com/v1
# CODEX_MODEL=gpt-5.4
# OPENAI_ENDPOINT=auto

# ---- Local debug only ----
# Enables POST /api/debug/auth/register on loopback only. Keep disabled in prod.
POLYFUSION_DEBUG_AUTH=0
